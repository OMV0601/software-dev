{
  "name": "echocode",
  "version": "1.0.0",
  "description": "Hear the shape of your code. Hear it run. A sound-first Python editor for blind and visually impaired learners.",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:js": "vitest run",
    "test:py": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:e2e": "node tests/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMV0601/software-dev.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/OMV0601/software-dev/issues"
  },
  "homepage": "https://github.com/OMV0601/software-dev#readme",
  "dependencies": {
    "@codemirror/lang-python": "6.1.7",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.8",
    "codemirror": "6.0.1",
    "pyodide": "0.27.7"
  },
  "devDependencies": {
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "private": true,
  "type": "module"
}
